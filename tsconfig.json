{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "jsxImportSource": "@alva-i18n",
    "paths": {
      "@alva-i18n/*": [
        "./web/src/i18n/*"
      ]
    }
  },
  "include": [
    "api",
    "web",
    "apps",
    "packages",
    "scripts",
    "tests",
    "playwright.config.ts"
  ]
}
