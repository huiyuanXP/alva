[Unit]
Description=alva Cloudflare Tunnel (authorized existing production tunnel)
After=network-online.target alva.service
Wants=network-online.target alva.service

[Service]
Type=notify
TimeoutStartSec=30
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --token-file /etc/cloudflared/prod-token
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
